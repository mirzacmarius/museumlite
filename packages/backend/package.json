{
  "name": "@v1/backend",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "node ../../scripts/guard-convex-cloud.mjs dev && convex dev --tail-logs",
    "codegen": "node ../../scripts/guard-convex-cloud.mjs codegen && convex codegen",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "setup": "node ../../scripts/guard-convex-cloud.mjs setup && convex dev --once && convex env set VALIDATE_ENV=true",
    "seed": "node ../../scripts/guard-convex-cloud.mjs seed && convex dev --once && convex run init",
    "lint": "biome check . --error-on-warnings",
    "test": "bun run test:no-placeholders && vitest run",
    "test:no-placeholders": "sh -c 'rg -n \"expect\\\\(true\\\\)\\\\.toBe\\\\(true\\\\)|expect\\\\(true\\\\)\" tests convex && exit 1 || exit 0'",
    "test:once": "bun run test:no-placeholders && vitest run",
    "test:watch": "vitest --watch"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/aggregate": "0.2.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/polar": "npm:@erquhart/convex-polar@0.2.0-alpha.5",
    "@convex-dev/rate-limiter": "0.3.2",
    "@oslojs/crypto": "^1.0.1",
    "@polar-sh/sdk": "^0.26.1",
    "convex": "^1.38.0",
    "convex-helpers": "^0.1.63",
    "lucia": "3.2.2",
    "openai": "^4.61.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.4",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "convex-test": "^0.0.41",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
