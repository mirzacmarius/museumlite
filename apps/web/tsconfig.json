{
  "extends": "@v1/typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "typeRoots": ["../../node_modules/@types", "./node_modules/@types"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.ts",
    "src/react-19-fix.d.ts"
  ],
  "exclude": ["node_modules"]
}
