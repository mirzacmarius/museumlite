# Monorepo-wide env (optional). Per-app .env files are synced via `bun run env:sync`.
# In git worktrees, run `bun dev` once — it copies/symlinks from your main clone automatically.
#
# Override source checkout:
#   export ML_ENV_SOURCE="$HOME/Developer/ml"

# Convex (also set in apps/app/.env and apps/web/.env)
NEXT_PUBLIC_CONVEX_URL=

# Shared deployment slug (packages/backend/.env.local)
CONVEX_DEPLOYMENT=
