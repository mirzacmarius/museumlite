{
  "$schema": "https://turborepo.org/schema.json",
  "agentGuidance": true,
  "globalDependencies": [
    "**/.env*",
    ".github/actions/**",
    ".github/workflows/**",
    ".gitignore",
    "biome.json",
    "bun.lock",
    "bunfig.toml",
    "package.json",
    "patches/**",
    "scripts/**",
    "tooling/typescript/**",
    "tsconfig*.json"
  ],
  "envMode": "strict",
  "ui": "stream",
  "tasks": {
    "topo": {
      "description": "Ordering-only task so dependents run after their workspace dependencies; it has no script.",
      "dependsOn": ["^topo"]
    },
    "build": {
      "description": "Production build of each app (Next.js for app and web, React Email for email). CI and Vercel run it.",
      "env": [
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "CI",
        "CONVEX_DEPLOY_KEY",
        "CONVEX_SITE_URL",
        "INTEGRATION_PRODUCT_LIBRARY",
        "LOOPS_API_KEY",
        "LOOPS_ENDPOINT",
        "LOOPS_FORM_ID",
        "LOCAL_QA",
        "LANG",
        "LC_ALL",
        "LOGTAIL_SOURCE_TOKEN",
        "LOGTAIL_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CAL_LINK",
        "NEXT_PUBLIC_CONVEX_SITE_URL",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_OPENPANEL_CLIENT_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_WEB_URL",
        "NEXT_DISABLE_TYPECHECK",
        "NEXT_RUNTIME",
        "NODE_ENV",
        "NOTIFICATION_EMAIL_FIXTURE_URL",
        "OPENPANEL_SECRET_KEY",
        "POLAR_INTEGRATIONS_WEBHOOK_SECRET",
        "POLAR_ORGANIZATION_TOKEN",
        "POLAR_WEBHOOK_SECRET",
        "PORT",
        "RESEND_API_KEY",
        "RESEND_SENDER_EMAIL_AUTH",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SITE_URL",
        "SKIP_TYPE_CHECK",
        "SKIP_ENV_VALIDATION",
        "TZ",
        "VERCEL",
        "VERCEL_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "dependsOn": ["^build", "^topo"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts", ".expo/**"]
    },
    "start": {
      "description": "Serve a previously built app. Never cached.",
      "cache": false
    },
    "test": {
      "description": "Vitest suites (app, web, ui, backend). Backend tests use convex-test and need no cloud deployment.",
      "dependsOn": ["^topo"],
      "env": [
        "CI",
        "CONVEX_SITE_URL",
        "INTEGRATION_PRODUCT_LIBRARY",
        "LOOPS_FORM_ID",
        "LOCAL_QA",
        "LANG",
        "LC_ALL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_CAL_LINK",
        "NEXT_PUBLIC_CONVEX_SITE_URL",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_OPENPANEL_CLIENT_ID",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_WEB_URL",
        "NEXT_DISABLE_TYPECHECK",
        "NODE_ENV",
        "NOTIFICATION_EMAIL_FIXTURE_URL",
        "OPENAI_API_KEY",
        "OPENPANEL_SECRET_KEY",
        "POLAR_INTEGRATIONS_WEBHOOK_SECRET",
        "POLAR_ORGANIZATION_TOKEN",
        "POLAR_WEBHOOK_SECRET",
        "PROJECTION_MEASURE",
        "RESEND_API_KEY",
        "RESEND_SENDER_EMAIL_AUTH",
        "NEXT_RUNTIME",
        "SKIP_TYPE_CHECK",
        "SKIP_ENV_VALIDATION",
        "SITE_URL",
        "TZ",
        "VALIDATE_ENV",
        "VERCEL",
        "VERCEL_URL",
        "VITEST"
      ],
      "inputs": ["$TURBO_DEFAULT$", "**/vitest.config.*", "**/vitest.setup.*"]
    },
    "clean": {
      "description": "Delete build output, .turbo and node_modules in each workspace.",
      "cache": false
    },
    "dev": {
      "description": "Long-running dev servers. Root bun dev also starts convex dev against the cloud, so agents use the local QA scripts instead.",
      "inputs": ["$TURBO_DEFAULT$", ".env"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "description": "Biome check with warnings treated as errors.",
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "description": "tsc --noEmit for each workspace.",
      "dependsOn": ["^topo"],
      "outputs": [
        ".next/cache/tsbuildinfo.json",
        "node_modules/.cache/tsbuildinfo.json",
        "tsconfig.tsbuildinfo"
      ]
    },
    "typecheck:i18n": {
      "description": "Strict check of translation keys in apps/app (tsconfig.i18n.json).",
      "dependsOn": ["^topo"],
      "outputs": [
        ".next/cache/tsbuildinfo.json",
        "node_modules/.cache/tsbuildinfo.json",
        "tsconfig.tsbuildinfo"
      ]
    }
  }
}
