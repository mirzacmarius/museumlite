{
  "ignore": {
    "overrides": [
      {
        "files": [
          "packages/backend/convex/**",
          "packages/backend/tests/**",
          "packages/backend/convex/**/*.test.ts"
        ],
        "rules": [
          "react-doctor/async-parallel",
          "react-doctor/server-sequential-independent-await",
          "react-doctor/async-await-in-loop"
        ]
      },
      {
        "files": ["apps/web/src/**/*.tsx", "src/**/*.tsx"],
        "rules": ["react-doctor/design-no-em-dash-in-jsx-text"]
      },
      {
        "files": [
          "apps/web/src/app/(marketing)/contact/actions.ts",
          "src/app/(marketing)/contact/actions.ts"
        ],
        "rules": ["react-doctor/server-auth-actions"]
      },
      {
        "files": [
          "packages/backend/convex/accountRelationships.ts",
          "packages/backend/convex/accessions.ts",
          "packages/backend/convex/collections.ts",
          "packages/backend/convex/deaccessions.ts",
          "packages/backend/convex/mediaImports.ts",
          "packages/backend/convex/reporting.ts",
          "packages/backend/convex/utils/collectionDisposition.ts",
          "packages/backend/convex/conditionAssessments.ts",
          "packages/backend/convex/conservationTreatments.ts",
          "packages/backend/convex/objectMoves.ts",
          "packages/backend/convex/utils/exhibitionWorkflow.ts",
          "packages/backend/convex/utils/transitPhysicalHandoff.ts",
          "packages/backend/convex/exports.ts",
          "packages/backend/convex/loans.ts",
          "packages/backend/convex/utils/exhibitionCrud.ts",
          "packages/backend/convex/partyLinks.ts",
          "packages/backend/convex/partyDuplicates.ts",
          "packages/backend/convex/utils/provenance.ts"
        ],
        "rules": ["react-doctor/async-defer-await"]
      },
      {
        "files": [
          "apps/app/src/hooks/use-tracked-import-runner.ts",
          "apps/app/src/app/**/settings/data/use-data-import.ts",
          "src/hooks/use-tracked-import-runner.ts",
          "src/app/**/settings/data/use-data-import.ts",
          "apps/app/src/app/**/collections/media-import/_components/use-media-import.ts",
          "src/app/**/collections/media-import/_components/use-media-import.ts",
          "apps/app/src/components/export-job-control.tsx",
          "src/components/export-job-control.tsx"
        ],
        "rules": ["react-doctor/async-await-in-loop"]
      },
      {
        "files": [
          "apps/app/src/app/**/media/media-publication-panel.tsx",
          "src/app/**/media/media-publication-panel.tsx"
        ],
        "rules": ["react-doctor/no-pure-black-background"]
      },
      {
        "files": ["packages/backend/convex/utils/reportSchedule.ts"],
        "rules": ["react-doctor/js-hoist-intl"]
      },
      {
        "files": [
          "apps/app/src/app/**/objects/[id]/_components/condition-assessment-panel.tsx",
          "src/app/**/objects/[id]/_components/condition-assessment-panel.tsx",
          "apps/app/src/app/**/conservation/[id]/_components/treatment-evidence-panel.tsx",
          "src/app/**/conservation/[id]/_components/treatment-evidence-panel.tsx"
        ],
        "rules": [
          "react-doctor/no-giant-component",
          "react-doctor/prefer-useReducer"
        ]
      },
      {
        "files": [
          "apps/app/src/app/**/exhibitions/page.tsx",
          "src/app/**/exhibitions/page.tsx"
        ],
        "rules": ["react-doctor/prefer-useReducer"]
      }
    ]
  }
}
